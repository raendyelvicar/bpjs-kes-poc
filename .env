# Copy to .env and fill in. Quote values with single quotes if they contain special characters.

# --- Kafka (only load-data.sh uses this) ---
BOOTSTRAP='148.230.103.240:19092'  # as reachable from where you run these scripts
# If the brokers need a login, copy client.properties.example to client.properties and edit it.

# --- ksqlDB ---
KSQL_URL='https://ksqldb.kafka.kodehive.id'
KSQL_AUTH='admin:Standar123$%'                       # user:password, or empty if no login

# --- Kafka Connect (must have the Elasticsearch sink plugin installed) ---
CONNECT_URL='https://connect.kafka.kodehive.id'
CONNECT_AUTH='admin:Standar123$%'                    # user:password, or empty if no login

# --- Elasticsearch ---
ES_URL='http://148.230.103.240:19200'      # as reachable from where you run these scripts
ES_AUTH='elastic:Standar123'                 # used by setup.sh for the index template
ES_SINK_URL=''                               # as reachable from the Connect worker; empty = same as ES_URL
ES_SINK_USER='elastic'                       # user the connector writes with
ES_SINK_PASSWORD='Standar123'

# --- Sizing ---
PARTITIONS=3
REPLICAS=1                         # must not be more than the number of brokers

OTEL_TOPIC='otel-traces'                  # the topic to which OpenTelemetry traces are sent
OTEL_SAMPLE_TOPIC='otlp_logs_sample'

NAME_SUFFIX='_dev'                     # added to every topic, stream, index and connector this pipeline creates
