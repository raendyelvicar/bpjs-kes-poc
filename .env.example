# Copy to .env and fill in. Quote values with single quotes if they contain special characters ($ ! # space).

# --- Names ---
NAME_SUFFIX=''                         # e.g. '_dev': added to every topic, stream, index and connector this pipeline creates
                                       # (a-z, 0-9 and _ only). Lets several copies share one cluster. The OTel source topic gets none.

# --- OpenTelemetry topics ---
OTEL_TOPIC='otlp_logs'                 # Kafka topic OTel writes its logs to (OTLP/JSON). Created if missing.
OTEL_SAMPLE_TOPIC='otlp_logs_sample'   # optional test topic (gets NAME_SUFFIX too), feeds the same pipeline. '' = skip it.

# --- Kafka (only load-data.sh uses this) ---
BOOTSTRAP='broker.example.com:9092'
# If the brokers need a login, copy client.properties.example to client.properties and edit it.

# --- ksqlDB ---
KSQL_URL='https://ksqldb.example.com'
KSQL_AUTH=''                           # user:password, or empty if no login

# --- Kafka Connect (needs the Confluent Elasticsearch sink plugin) ---
CONNECT_URL='https://connect.example.com'
CONNECT_AUTH=''                        # user:password, or empty if no login

# --- Elasticsearch (8.3 or newer) ---
ES_URL='https://es.example.com'        # as reachable from where you run these scripts
ES_AUTH='elastic:change-me'            # used by setup.sh / check.sh / reset.sh
ES_SINK_URL=''                         # as reachable from the Connect worker; empty = same as ES_URL
ES_SINK_USER='elastic'                 # user the connector writes with
ES_SINK_PASSWORD='change-me'

# --- Sizing (used only for topics this pipeline creates) ---
PARTITIONS=3
REPLICAS=1                             # must not be more than the number of brokers
